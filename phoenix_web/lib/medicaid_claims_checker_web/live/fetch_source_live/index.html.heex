<div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
  <div class="mx-auto max-w-7xl">

    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div class="mb-4 p-4 bg-red-100 border border-red-300 rounded-lg">
        <p class="text-sm text-red-900 font-semibold"><%= Phoenix.Flash.get(@flash, :error) %></p>
      </div>
    <% end %>

    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div class="mb-4 p-4 bg-blue-100 border border-blue-300 rounded-lg">
        <p class="text-sm text-blue-900"><%= Phoenix.Flash.get(@flash, :info) %></p>
      </div>
    <% end %>

    <!-- Page Header -->
    <div class="mb-6 p-4 bg-white rounded-lg shadow-md">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Claims Ingestion</h1>
          <p class="mt-2 text-base text-gray-800 font-medium">Configure how claim files are ingested — manual uploads, scheduled fetches, and processing history</p>
        </div>
        <div class="flex gap-2">
          <a href={~p"/rules"} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium rounded-md border border-gray-300">
            Business Rules
          </a>
        </div>
      </div>
      <div class="mt-3 p-3 bg-blue-100 border border-blue-300 rounded-md">
        <p class="text-sm text-blue-900 font-medium">
          Define fetch locations (SFTP, local, HTTP, Databricks) and schedules. Add sources, attach cron or interval schedules, and the app polls every 60 seconds automatically. Toggle sources or schedules off to pause without losing configuration.
        </p>
      </div>
    </div>

    <!-- NPPES Provider Registry -->
    <div class="mb-6 bg-green-100 border border-green-200 shadow-md rounded-lg">
      <div class="px-4 py-3 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">NPPES Provider Registry</h2>
            <p class="text-xs text-gray-800 mt-1">
              Automated refresh of the National Provider registry used for NPI validation
            </p>
          </div>
          <div class="flex items-center gap-3">
            <!-- Status badge -->
            <%= unless @nppes_refreshing do %>
              <%= case @nppes_config.last_status do %>
                <% "completed" -> %>
                  <span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded font-medium">Up to date</span>
                <% "failed" -> %>
                  <span class="px-2 py-1 text-xs bg-red-100 text-red-800 rounded font-medium">Failed</span>
                <% _ -> %>
                  <span class="px-2 py-1 text-xs bg-gray-200 text-gray-800 rounded font-medium">Never refreshed</span>
              <% end %>
              <span class="text-xs text-gray-800">
                <%= format_nppes_time(@nppes_config.last_refresh_at) %> &middot; <%= format_number(@nppes_provider_count) %> providers
              </span>
              <button
                type="button"
                phx-click="nppes_refresh_now"
                class="px-3 py-1.5 text-xs font-medium rounded bg-blue-600 hover:bg-blue-700 text-white cursor-pointer"
              >
                Refresh Now
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Loading progress bar (visible only during refresh) -->
      <%= if @nppes_refreshing do %>
        <div class="px-4 py-3 bg-yellow-50 border-t border-b border-yellow-200">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-yellow-500"></span>
              </span>
              <span class="text-sm font-semibold text-yellow-900">Loading NPPES data...</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm font-medium text-yellow-800">
                <%= @nppes_elapsed_display %> elapsed
              </span>
              <%= if @nppes_rows_imported > 0 do %>
                <span class="text-sm text-yellow-700">
                  &middot; <%= format_number(@nppes_rows_imported) %> rows imported
                </span>
              <% end %>
              <button
                type="button"
                phx-click="nppes_cancel_refresh"
                class="px-3 py-1.5 text-xs font-medium rounded bg-red-600 hover:bg-red-700 text-white cursor-pointer"
              >
                Cancel
              </button>
            </div>
          </div>
          <div class="w-full bg-yellow-200 rounded-full h-1.5">
            <div class="bg-yellow-500 h-1.5 rounded-full animate-pulse" style="width: 100%"></div>
          </div>
        </div>
      <% end %>

      <!-- Error banner (visible after failure) -->
      <%= if not @nppes_refreshing and @nppes_config.last_status == "failed" and @nppes_config.last_error do %>
        <div class="px-4 py-3 bg-red-50 border-t border-b border-red-300">
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-red-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <div>
              <p class="text-sm font-semibold text-red-900">NPPES refresh failed</p>
              <p class="text-sm text-red-800 mt-1"><%= @nppes_config.last_error %></p>
            </div>
          </div>
        </div>
      <% end %>

      <div class="p-4">

        <.form for={%{}} phx-submit="save_nppes_config" id="nppes-config-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-[auto_1fr_2fr] gap-4 items-start">
            <!-- Auto-refresh toggle -->
            <div>
              <label class="block text-sm font-medium text-gray-900 mb-2">Auto-refresh</label>
              <div class="flex items-center h-[38px]">
                <button
                  type="button"
                  phx-click="toggle_nppes_auto_refresh"
                  aria-pressed={to_string(@nppes_config.auto_refresh)}
                  aria-label="Auto-refresh NPPES"
                  class={"relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer #{if @nppes_config.auto_refresh, do: "bg-blue-600", else: "bg-gray-300"}"}
                >
                  <span class={"inline-block h-4 w-4 transform rounded-full bg-white transition-transform #{if @nppes_config.auto_refresh, do: "translate-x-6", else: "translate-x-1"}"} />
                </button>
                <span class="ml-2 text-xs text-gray-800">
                  <%= if @nppes_config.auto_refresh, do: "Enabled", else: "Disabled" %>
                </span>
              </div>
            </div>

            <!-- Interval -->
            <div>
              <label for="nppes-interval" class="block text-sm font-medium text-gray-900 mb-2">Refresh Interval</label>
              <select
                id="nppes-interval"
                name="nppes[interval_seconds]"
                class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
              >
                <option value="86400" selected={@nppes_config.interval_seconds == 86_400}>Daily</option>
                <option value="604800" selected={@nppes_config.interval_seconds == 604_800}>Weekly</option>
                <option value="1209600" selected={@nppes_config.interval_seconds == 1_209_600}>Bi-weekly</option>
                <option value="2592000" selected={@nppes_config.interval_seconds == 2_592_000}>Monthly</option>
              </select>
              <p class="text-[10px] text-gray-800 mt-1">
                Currently: <%= interval_label(@nppes_config.interval_seconds) %>
              </p>
            </div>

            <!-- Download URL -->
            <div>
              <label for="nppes-url" class="block text-sm font-medium text-gray-900 mb-2">Download URL</label>
              <input
                id="nppes-url"
                name="nppes[download_url]"
                value={@nppes_config.download_url}
                class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                placeholder="https://download.cms.gov/nppes/..."
              />
            </div>
          </div>

          <%= if @nppes_form_error do %>
            <div class="p-2 bg-red-100 border border-red-300 rounded">
              <p class="text-xs text-red-900"><%= @nppes_form_error %></p>
            </div>
          <% end %>

          <button
            type="submit"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium cursor-pointer"
          >
            Save Settings
          </button>
        </.form>
      </div>
    </div>

    <!-- Manual Upload -->
    <div class="mb-6 bg-blue-100 border border-blue-200 shadow-md rounded-lg overflow-hidden">
      <div class="px-4 py-3 border-b border-blue-200">
        <h2 class="text-lg font-semibold text-gray-900">Manual Upload</h2>
        <p class="text-xs text-gray-800 mt-1">Drag & drop claim files from your system for on-the-fly processing</p>
      </div>

      <div class="p-4">
        <.form for={%{}} phx-change="validate_manual_uploads" phx-submit="process_manual_upload" id="manual-upload-form">
          <.live_file_input upload={@uploads.manual_files} class="sr-only" />

          <div
            class="border-2 border-dashed border-gray-400 rounded-lg p-8 text-center bg-gray-50 hover:bg-gray-100 transition-colors cursor-pointer mb-4 phx-drop-target-active:bg-blue-50 phx-drop-target-active:border-blue-400"
            phx-drop-target={@uploads.manual_files.ref}
          >
            <svg class="mx-auto h-10 w-10 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="text-sm text-gray-800">Drag & drop <strong>.json</strong>, <strong>.x12</strong>, <strong>.edi</strong>, or <strong>.zip</strong> files here</p>
            <p class="text-xs text-gray-400 mt-1">JSON files are evaluated directly. X12/EDI files are translated in-app before evaluation.</p>
          </div>

          <div class="flex items-center gap-3 mb-4">
            <div class="flex-1 border-t border-gray-300"></div>
            <span class="text-xs font-medium text-gray-400 uppercase">or</span>
            <div class="flex-1 border-t border-gray-300"></div>
          </div>

          <div class="mb-4">
            <label for={@uploads.manual_files.ref} class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md cursor-pointer">
              Choose Files
            </label>
          </div>

          <%= if @uploads.manual_files.entries != [] do %>
            <div class="mb-4">
              <div class="flex items-center justify-between mb-2">
                <p class="text-sm font-medium text-gray-900">
                  Selected files
                  <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold bg-blue-200 text-blue-900 rounded-full">
                    <%= length(@uploads.manual_files.entries) %>
                  </span>
                </p>
                <button
                  type="button"
                  phx-click="clear_manual_uploads"
                  disabled={@upload_status == :processing}
                  class="px-3 py-1 bg-gray-500 hover:bg-gray-600 text-white rounded text-xs font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                >
                  Clear Files
                </button>
              </div>
              <ul class="text-xs text-gray-900 space-y-1 max-h-32 overflow-y-auto">
                <%= for entry <- @uploads.manual_files.entries do %>
                  <li class="flex items-center gap-2">
                    <span class={"w-2 h-2 rounded-full inline-block #{file_type_color(entry.client_name)}"}></span>
                    <%= entry.client_name %>
                    <span class="text-gray-800">(<%= Float.round(entry.client_size / 1024, 1) %> KB)</span>
                    <span class={"text-xs px-1.5 py-0.5 rounded #{file_type_badge(entry.client_name)}"}><%= file_type_label(entry.client_name) %></span>
                    <%= if entry.valid? do %>
                      <span class="text-green-700">&#10003;</span>
                    <% else %>
                      <span class="text-red-700">&#10007;</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= for err <- upload_errors(@uploads.manual_files) do %>
            <p class="text-sm text-red-600 mt-2"><%= upload_error_to_string(err) %></p>
          <% end %>

          <!-- Process action bar -->
          <div class="flex items-center justify-between border-t border-gray-200 pt-4">
            <p class="text-sm text-gray-800">
              <%= if @uploads.manual_files.entries == [] do %>
                Select claim files above, then click Process.
              <% else %>
                <%= length(@uploads.manual_files.entries) %> file<%= if length(@uploads.manual_files.entries) != 1, do: "s" %> ready to process.
              <% end %>
            </p>
            <button
              type="submit"
              disabled={@uploads.manual_files.entries == []}
              class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            >
              Process Files
            </button>
          </div>
        </.form>

        <!-- Status messages -->
        <%= if @upload_status == :submitted do %>
          <div role="alert" class="mt-4 p-3 bg-yellow-50 border border-yellow-300 rounded-lg flex items-center gap-2">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-yellow-500"></span>
            </span>
            <p class="text-sm text-yellow-900"><%= @upload_message %></p>
            <p class="text-xs text-yellow-700 ml-auto">Results will appear in history below when translation completes.</p>
          </div>
        <% end %>

        <%= if @upload_status == :processing do %>
          <div role="alert" aria-live="polite" class="mt-4 p-3 bg-blue-50 border border-blue-300 rounded-lg flex items-center gap-2">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500"></span>
            </span>
            <p class="text-sm text-blue-900"><%= @upload_message %></p>
          </div>
        <% end %>

        <%= if @upload_status == :done do %>
          <div role="alert" class="mt-4 p-3 bg-green-50 border border-green-300 rounded-lg">
            <p class="text-sm font-medium text-green-900"><%= @upload_message %></p>
          </div>
        <% end %>

        <%= if @upload_status == :error do %>
          <div role="alert" class="mt-4 p-3 bg-red-50 border border-red-300 rounded-lg">
            <p class="text-sm text-red-900"><%= @upload_message %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sources -->
    <div class="mb-6 bg-blue-100 border border-blue-200 shadow-md rounded-lg overflow-hidden">
      <div class="px-4 py-3 border-b border-blue-200 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <h2 class="text-lg font-semibold text-gray-900">Scheduled Jobs</h2>
          <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-800 rounded-full"><%= length(@sources) %> total</span>
          <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-800 rounded-full"><%= Enum.count(@sources, & &1.enabled) %> enabled</span>
          <%= if Enum.any?(@sources, &(not &1.enabled)) do %>
            <span class="px-2 py-0.5 text-xs font-medium bg-gray-200 text-gray-800 rounded-full"><%= Enum.count(@sources, &(not &1.enabled)) %> disabled</span>
          <% end %>
          <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-700 rounded-full"><%= @sources |> Enum.flat_map(& &1.fetch_schedules) |> length() %> schedules</span>
        </div>
        <button
          type="button"
          phx-click="toggle_add_source_form"
          aria-expanded={to_string(@show_source_form)}
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md cursor-pointer"
        >
          <%= if @show_source_form, do: "Cancel", else: "+ New Job" %>
        </button>
      </div>

      <%= if @show_source_form do %>
        <div class="border-b border-gray-200">
          <.form
            for={%{}}
            phx-submit="save_source"
            id="source-form"
            class="p-4 space-y-4 bg-gray-50"
          >
            <p class="text-sm font-medium text-gray-800">
              <%= if @editing_source, do: "Edit Source", else: "New Job" %>
            </p>
            <div class="grid grid-cols-1 md:grid-cols-[1fr_3fr_auto] gap-4">
              <div>
                <label for="source-name" class="block text-sm font-medium text-gray-900 mb-1">Name <span class="text-red-600">*</span></label>
                <input
                  id="source-name"
                  name="source[name]"
                  value={@source_name}
                  class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                  placeholder="e.g., Daily SFTP Drop"
                />
              </div>
              <div>
                <label for="source-uri" class="block text-sm font-medium text-gray-900 mb-1">URI / Path <span class="text-red-600">*</span></label>
                <input
                  id="source-uri"
                  name="source[uri]"
                  value={@source_uri}
                  class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                  placeholder="e.g., sftp://claims.example.com/daily"
                />
              </div>
              <div class="w-32">
                <label for="source-type" class="block text-sm font-medium text-gray-900 mb-1">Type <span class="text-red-600">*</span></label>
                <select
                  id="source-type"
                  name="source[type]"
                  class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                >
                  <option value="sftp" selected={@source_type == "sftp"}>SFTP</option>
                  <option value="local" selected={@source_type == "local"}>Local Directory</option>
                  <option value="http" selected={@source_type == "http"}>HTTP</option>
                  <option value="databricks" selected={@source_type == "databricks"}>Databricks</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="source-password" class="block text-sm font-medium text-gray-900 mb-1">Password / Secret</label>
                <input
                  id="source-password"
                  name="source[password]"
                  value={@source_password}
                  type="password"
                  class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                  placeholder="SFTP password or API key (leave blank to keep existing)"
                />
              </div>
              <div>
                <label for="source-username" class="block text-sm font-medium text-gray-900 mb-1">Username (optional override)</label>
                <input
                  id="source-username"
                  name="source[username]"
                  value={@source_username}
                  class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                  placeholder="Override username from URI (optional)"
                />
              </div>
            </div>

            <%= if @form_error do %>
              <div class="p-3 bg-red-100 border border-red-300 rounded-md">
                <p class="text-sm text-red-900"><%= @form_error %></p>
              </div>
            <% end %>

            <div class="flex gap-2">
              <button
                type="submit"
                class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium cursor-pointer"
              >
                <%= if @editing_source, do: "Update Job", else: "Save Job" %>
              </button>
              <button
                type="button"
                phx-click="toggle_add_source_form"
                class="px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-md text-sm font-medium cursor-pointer"
              >
                Cancel
              </button>
            </div>
          </.form>
        </div>
      <% end %>

      <%= if @sources == [] do %>
        <div class="p-8 text-center text-sm text-gray-800">
          No scheduled jobs configured yet. Use the <strong>+ New Job</strong> button to add one.
        </div>
      <% else %>
        <table class="w-full text-sm">
          <thead class="bg-gray-100 border-b border-gray-300">
            <tr>
              <th class="px-4 py-3 text-left font-semibold text-gray-800"></th>
              <th class="px-4 py-3 text-left font-semibold text-gray-800">Name</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-800">URI / Path</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-800">Type</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-800">Schedules</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-800">Status</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-800">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <%= for source <- @sources do %>
              <tr class={"hover:bg-gray-50 #{if not source.enabled, do: "opacity-60"}"}>
                <td class="px-4 py-3">
                  <button
                    type="button"
                    phx-click="toggle_expand_source"
                    phx-value-id={source.id}
                    class="text-gray-800 hover:text-gray-800 cursor-pointer"
                  >
                    <%= if MapSet.member?(@expanded_source_ids, source.id) do %>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    <% else %>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    <% end %>
                  </button>
                </td>
                <td class="px-4 py-3 font-medium text-gray-900"><%= source.name %></td>
                <td class="px-4 py-3 text-gray-800 text-xs max-w-xs truncate" title={source.uri}><%= source.uri %></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 text-xs bg-indigo-100 text-indigo-800 rounded font-medium">
                    <%= source_type_label(source.source_type) %>
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-800">
                  <%= length(source.fetch_schedules) %>
                </td>
                <td class="px-4 py-3">
                  <%= if source.enabled do %>
                    <span class="px-2 py-0.5 text-xs bg-green-100 text-green-800 rounded font-medium">Enabled</span>
                  <% else %>
                    <span class="px-2 py-0.5 text-xs bg-gray-200 text-gray-800 rounded font-medium">Disabled</span>
                  <% end %>
                  <%= if source.credentials && map_size(source.credentials) > 0 && source.credentials["password"] do %>
                    <span class="ml-1 px-2 py-0.5 text-xs bg-yellow-100 text-yellow-800 rounded font-medium">Key</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-2">
                    <button
                      type="button"
                      phx-click="toggle_source_enabled"
                      phx-value-id={source.id}
                      class="px-3 py-1 text-xs font-medium rounded bg-indigo-100 hover:bg-indigo-200 text-indigo-800 cursor-pointer"
                    >
                      <%= if source.enabled, do: "Disable", else: "Enable" %>
                    </button>
                    <button
                      type="button"
                      phx-click="edit_source"
                      phx-value-id={source.id}
                      class="px-3 py-1 text-xs font-medium rounded bg-blue-100 hover:bg-blue-200 text-blue-800 cursor-pointer"
                    >
                      Edit
                    </button>
                    <button
                      type="button"
                      phx-click="delete_source"
                      phx-value-id={source.id}
                      class="px-3 py-1 text-xs font-medium rounded bg-red-100 hover:bg-red-200 text-red-800 cursor-pointer"
                      data-confirm="Delete this source and all its schedules?"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>

              <!-- Expanded: Cron Schedules -->
              <%= if MapSet.member?(@expanded_source_ids, source.id) do %>
                <tr>
                  <td colspan="7" class="px-8 py-4 bg-gray-50">
                    <div class="flex items-center justify-between mb-3">
                      <h3 class="text-sm font-semibold text-gray-800">Run Times for "<%= source.name %>"</h3>
                      <button
                        type="button"
                        phx-click="show_add_schedule"
                        phx-value-source-id={source.id}
                        class="px-3 py-1 text-xs font-medium rounded bg-green-600 hover:bg-green-700 text-white cursor-pointer"
                      >
                        + Add Run Time
                      </button>
                    </div>

                    <%= if source.fetch_schedules == [] do %>
                      <p class="text-xs text-gray-800">No run times configured. Add one to start automated fetching.</p>
                    <% else %>
                      <table class="w-full text-xs">
                        <thead>
                          <tr class="border-b border-gray-300">
                            <th class="px-3 py-2 text-left font-semibold text-gray-800">Cron Schedule</th>
                            <th class="px-3 py-2 text-left font-semibold text-gray-800">Status</th>
                            <th class="px-3 py-2 text-left font-semibold text-gray-800">Actions</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                          <%= for schedule <- source.fetch_schedules do %>
                            <tr class={"#{if not schedule.enabled, do: "opacity-60"}"}>
                              <td class="px-3 py-2 text-gray-900 font-medium"><%= schedule_description(schedule) %></td>
                              <td class="px-3 py-2">
                                <%= if schedule.enabled do %>
                                  <span class="px-2 py-0.5 text-[10px] bg-green-100 text-green-800 rounded font-medium">Active</span>
                                <% else %>
                                  <span class="px-2 py-0.5 text-[10px] bg-gray-200 text-gray-800 rounded font-medium">Paused</span>
                                <% end %>
                              </td>
                              <td class="px-3 py-2">
                                <div class="flex gap-2">
                                  <button
                                    type="button"
                                    phx-click="toggle_schedule_enabled"
                                    phx-value-id={schedule.id}
                                    class="px-2 py-0.5 text-[10px] font-medium rounded bg-indigo-100 hover:bg-indigo-200 text-indigo-800 cursor-pointer"
                                  >
                                    <%= if schedule.enabled, do: "Pause", else: "Resume" %>
                                  </button>
                                  <button
                                    type="button"
                                    phx-click="edit_schedule"
                                    phx-value-id={schedule.id}
                                    phx-value-source-id={source.id}
                                    class="px-2 py-0.5 text-[10px] font-medium rounded bg-blue-100 hover:bg-blue-200 text-blue-800 cursor-pointer"
                                  >
                                    Change
                                  </button>
                                  <button
                                    type="button"
                                    phx-click="delete_schedule"
                                    phx-value-id={schedule.id}
                                    class="px-2 py-0.5 text-[10px] font-medium rounded bg-red-100 hover:bg-red-200 text-red-800 cursor-pointer"
                                    data-confirm="Remove this schedule?"
                                  >
                                    Remove
                                  </button>
                                </div>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    <% end %>

                    <!-- Add/Edit Schedule Form (inline) -->
                    <%= if @adding_schedule_for == source.id do %>
                      <div class="mt-3 p-3 bg-white border border-gray-300 rounded-md">
                        <.form for={%{}} phx-submit="save_schedule" phx-change="update_schedule_form" id={"schedule-form-#{source.id}"} class="space-y-3">
                          <p class="text-xs font-medium text-gray-800">
                            <%= if @editing_schedule, do: "Edit schedule:", else: "Provide either a cron expression or an interval (not both):" %>
                          </p>
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                              <label class="block text-xs font-medium text-gray-800 mb-1">Cron Expression</label>
                              <input
                                name="schedule[cron]"
                                value={@schedule_cron}
                                phx-debounce="300"
                                onfocus="this.select()"
                                class="w-full px-2 py-1.5 border border-gray-400 rounded text-xs text-gray-900 bg-white"
                                placeholder="e.g., 0 */6 * * *"
                              />
                              <p class="text-[10px] text-gray-800 mt-1">min hour day month weekday</p>
                            </div>
                            <div>
                              <label class="block text-xs font-medium text-gray-800 mb-1">Interval (seconds)</label>
                              <input
                                name="schedule[interval]"
                                value={@schedule_interval}
                                type="number"
                                min="60"
                                class="w-full px-2 py-1.5 border border-gray-400 rounded text-xs text-gray-900 bg-white"
                                placeholder="e.g., 3600 (1 hour)"
                              />
                              <p class="text-[10px] text-gray-800 mt-1">Minimum 60 seconds</p>
                            </div>
                          </div>

                          <%= if @form_error do %>
                            <div class="p-2 bg-red-100 border border-red-300 rounded">
                              <p class="text-xs text-red-900"><%= @form_error %></p>
                            </div>
                          <% end %>

                          <div class="flex gap-2">
                            <button type="submit" class="px-3 py-1.5 text-xs font-medium rounded bg-green-600 hover:bg-green-700 text-white cursor-pointer">
                              <%= if @editing_schedule, do: "Update Run Time", else: "Save Run Time" %>
                            </button>
                            <button type="button" phx-click="cancel_add_schedule" class="px-3 py-1.5 text-xs font-medium rounded bg-gray-200 hover:bg-gray-300 text-gray-800 cursor-pointer">
                              Cancel
                            </button>
                          </div>
                        </.form>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>

    <!-- Batch History section -->
    <div class="mt-8 mb-6 bg-gray-100 border border-gray-300 rounded-lg shadow-md overflow-hidden">
      <div>
        <button
          type="button"
          phx-click="toggle_batch_history"
          aria-expanded={to_string(@show_batch_history)}
          aria-controls="batch-history-panel"
          class="w-full px-6 py-4 cursor-pointer select-none flex items-center justify-between hover:bg-gray-50"
        >
          <div class="flex items-center gap-2">
            <svg class={"w-4 h-4 text-gray-800 transition-transform #{if @show_batch_history, do: "rotate-90"}"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <h2 class="text-xl font-semibold text-gray-900">Jobs History (manual & batch)</h2>
            <span class="text-sm font-normal text-gray-800">
              — <%= length(@batch_history) %> batches
            </span>
          </div>
        </button>

      <%= if @show_batch_history do %>
      <div id="batch-history-panel" class="px-6 pb-6">
      <p class="mb-3 text-sm text-gray-800">All processed claim batches — manual uploads and scheduled fetch imports</p>
      <div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
        <!-- Risk level filter pills -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-xs font-medium text-gray-500 mr-1">Filter by risk:</span>
          <%= for {label, level, active_class, inactive_class} <- [
            {"All",      nil,            "bg-gray-800 text-white border-gray-800",         "bg-white text-gray-700 border-gray-300 hover:bg-gray-50"},
            {"Clean",    "Clean",        "bg-blue-600 text-white border-blue-600",          "bg-white text-blue-700 border-blue-300 hover:bg-blue-50"},
            {"Low",      "LowRisk",      "bg-green-600 text-white border-green-600",        "bg-white text-green-700 border-green-300 hover:bg-green-50"},
            {"Medium",   "MediumRisk",   "bg-yellow-500 text-white border-yellow-500",      "bg-white text-yellow-700 border-yellow-300 hover:bg-yellow-50"},
            {"High",     "HighRisk",     "bg-orange-500 text-white border-orange-500",      "bg-white text-orange-700 border-orange-300 hover:bg-orange-50"},
            {"Critical", "CriticalRisk", "bg-red-600 text-white border-red-600",            "bg-white text-red-700 border-red-300 hover:bg-red-50"}
          ] do %>
            <button
              type="button"
              phx-click="filter_batch_risk"
              phx-value-level={level}
              class={[
                "px-3 py-1 text-xs font-semibold rounded-full border cursor-pointer transition-colors",
                if(@batch_risk_filter == level, do: active_class, else: inactive_class)
              ]}
            >
              <%= label %>
            </button>
          <% end %>
        </div>

        <!-- Refresh / Clear -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            phx-click="refresh_batch_history"
            phx-disable-with="Refreshing..."
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md border border-gray-300 bg-white hover:bg-gray-50 text-gray-800 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Refresh
          </button>
          <button
            type="button"
            phx-click="clear_batch_history"
            phx-disable-with="Clearing..."
            data-confirm="Clear all batches from display? Data is preserved — click Refresh to reload."
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md border border-red-300 bg-white hover:bg-red-50 text-red-700 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Clear
          </button>
        </div>
      </div>

      <%= if @batch_history == [] do %>
        <div class="text-center py-8 text-gray-800">
          <svg class="mx-auto w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
          <p class="text-sm font-medium">No batches received yet</p>
          <p class="text-xs mt-1">Batches will appear here as claims are ingested</p>
        </div>
      <% else %>
        <div class="space-y-3">
          <%= for batch <- @batch_history do %>
            <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
              <div class="flex items-center px-4 py-3 hover:bg-gray-50">
                <button
                  phx-click="toggle_batch_detail"
                  phx-value-id={batch.id}
                  class="flex-1 flex items-center justify-between text-left cursor-pointer"
                >
                  <div class="flex items-center gap-4">
                    <span class={[
                      "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold",
                      cond do
                        batch.status == "completed" -> "bg-green-100 text-green-800"
                        batch.status == "processing" -> "bg-blue-100 text-blue-800"
                        batch.status == "failed" -> "bg-red-100 text-red-800"
                        true -> "bg-gray-100 text-gray-800"
                      end
                    ]}>
                      <%= batch.status %>
                    </span>
                    <div>
                      <span class="text-sm font-semibold text-gray-900"><%= batch.batch_name || batch.batch_id %></span>
                      <span class={"ml-2 px-1.5 py-0.5 text-[10px] font-medium rounded #{if batch.source in ["ui_upload", "manual_upload"], do: "bg-blue-100 text-blue-700", else: "bg-purple-100 text-purple-700"}"}>
                        <%= if batch.source in ["ui_upload", "manual_upload"], do: "Manual", else: "Batch" %>
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-4 text-sm text-gray-800">
                    <span><%= batch.file_count %> claims</span>
                    <span><%= Calendar.strftime(batch.inserted_at, "%b %d, %Y %H:%M") %></span>
                    <svg class={[
                      "w-5 h-5 text-gray-400 transition-transform",
                      if(MapSet.member?(@expanded_batch_ids, batch.id), do: "rotate-180", else: "")
                    ]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </button>
                <button
                  type="button"
                  phx-click="dismiss_batch"
                  phx-value-id={batch.id}
                  class="ml-2 p-1 rounded hover:bg-red-100 text-gray-400 hover:text-red-600 cursor-pointer"
                  aria-label="Remove from display"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <%= if MapSet.member?(@expanded_batch_ids, batch.id) do %>
                <div class="border-t border-gray-200 px-4 py-3 bg-gray-50">
                  <% visible_files = case @batch_risk_filter do
                    nil -> batch.files
                    "Clean" -> Enum.filter(batch.files, &(&1.matched_rules == 0))
                    level -> Enum.filter(batch.files, &(&1.risk == level))
                  end %>
                  <%= if batch.files == [] do %>
                    <p class="text-sm text-gray-800 py-2">No detailed file records available for this batch.</p>
                  <% else %>
                  <%= if visible_files == [] do %>
                    <p class="text-sm text-gray-500 py-2 italic">No claims match the selected risk filter for this batch.</p>
                  <% else %>
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="text-left text-xs font-semibold text-gray-800 uppercase">
                        <th class="pb-2 w-8"></th>
                        <th class="pb-2 pr-4">Filename</th>
                        <th class="pb-2 pr-4">Status</th>
                        <th class="pb-2 pr-4">Risk Level</th>
                        <th class="pb-2 pr-4">Rules Matched</th>
                        <th class="pb-2 pr-4">Weight</th>
                        <th class="pb-2">Summary</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for file <- visible_files do %>
                        <% file_expanded = MapSet.member?(@expanded_batch_file_ids, file.id) %>
                        <tr
                          class={"border-t border-gray-100 hover:bg-gray-100 cursor-pointer #{if file_expanded, do: "bg-gray-100"}"}
                          phx-click="toggle_batch_file_detail"
                          phx-value-id={file.id}
                        >
                          <td class="py-2 pl-1">
                            <svg class={"w-4 h-4 text-gray-400 transition-transform #{if file_expanded, do: "rotate-90"}"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                          </td>
                          <td class="py-2 pr-4 font-medium text-gray-900 text-xs"><%= file.filename %></td>
                          <td class="py-2 pr-4">
                            <%= if file.matched_rules > 0 do %>
                              <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-red-100 text-red-800">FLAGGED</span>
                            <% else %>
                              <%= if batch.status == "failed" and file.status == "translated" do %>
                                <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-gray-100 text-gray-600">NOT EVALUATED</span>
                              <% else %>
                                <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-green-100 text-green-800">CLEAN</span>
                              <% end %>
                            <% end %>
                          </td>
                          <td class="py-2 pr-4">
                            <span class={[
                              "text-xs font-semibold",
                              cond do
                                file.risk == "CriticalRisk" -> "text-red-700"
                                file.risk == "HighRisk" -> "text-orange-600"
                                file.risk == "MediumRisk" -> "text-yellow-700"
                                true -> "text-green-700"
                              end
                            ]}>
                              <%= file.risk %>
                            </span>
                          </td>
                          <td class="py-2 pr-4 text-gray-800"><%= file.matched_rules %></td>
                          <td class="py-2 pr-4">
                            <span class={[
                              "text-xs font-semibold",
                              cond do
                                file.weighted_score >= 6 -> "text-red-700"
                                file.weighted_score >= 3 -> "text-orange-600"
                                file.weighted_score >= 1 -> "text-yellow-700"
                                true -> "text-gray-400"
                              end
                            ]}>
                              <%= file.weighted_score %>
                            </span>
                          </td>
                          <td class="py-2 text-xs text-gray-800">
                            <%= if file.matched_results != [] do %>
                              <%= (file.matched_results |> List.first()).rule %>
                              <%= if length(file.matched_results) > 1, do: "+ #{length(file.matched_results) - 1} more" %>
                            <% else %>
                              <span class="text-green-600">No rules triggered</span>
                            <% end %>
                          </td>
                        </tr>

                        <!-- Expanded file detail -->
                        <%= if file_expanded do %>
                          <tr>
                            <td colspan="7" class="px-0 py-0">
                              <div class="bg-white border-t border-b border-gray-200 px-8 py-4">
                                <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-5 space-y-4">
                                  <h4 class="text-sm font-bold text-gray-900">
                                    Fraud Detection Details
                                    <span class="ml-2 font-mono text-xs text-gray-800"><%= file.filename %></span>
                                  </h4>

                                  <!-- Score bar -->
                                  <div>
                                    <div class="flex justify-between items-center mb-1">
                                      <span class="text-xs font-medium text-gray-800">Rules triggered</span>
                                      <span class="text-xs font-bold text-gray-900"><%= file.matched_rules %></span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                                      <div class={[
                                        "h-full rounded-full",
                                        cond do
                                          file.risk == "CriticalRisk" -> "bg-red-500"
                                          file.risk == "HighRisk" -> "bg-orange-500"
                                          file.risk == "MediumRisk" -> "bg-yellow-500"
                                          true -> "bg-green-500"
                                        end
                                      ]} style={"width: #{min(file.matched_rules * 25, 100)}%"}></div>
                                    </div>
                                  </div>

                                  <!-- Weighted score breakdown -->
                                  <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
                                    <div class="flex items-center justify-between mb-2">
                                      <span class="text-xs font-semibold text-gray-800 uppercase">Weighted Score</span>
                                      <span class={[
                                        "text-2xl font-bold",
                                        cond do
                                          file.weighted_score >= 6 -> "text-red-700"
                                          file.weighted_score >= 3 -> "text-orange-600"
                                          file.weighted_score >= 1 -> "text-yellow-700"
                                          true -> "text-green-600"
                                        end
                                      ]}>
                                        <%= file.weighted_score %>
                                      </span>
                                    </div>
                                    <% reject_count = Enum.count(file.matched_results, &(&1.action == "REJECT")) %>
                                    <% fraud_count  = Enum.count(file.matched_results, &(&1.action == "FRAUD")) %>
                                    <% review_count = Enum.count(file.matched_results, &(&1.action == "REVIEW")) %>
                                    <div class="space-y-1 text-xs text-gray-700">
                                      <%= if reject_count > 0 do %>
                                        <div class="flex justify-between">
                                          <span><span class="font-semibold text-red-700">REJECT</span> &times; <%= reject_count %> &nbsp;<span class="text-gray-400">(3 pts each)</span></span>
                                          <span class="font-semibold text-red-700"><%= reject_count * 3 %></span>
                                        </div>
                                      <% end %>
                                      <%= if fraud_count > 0 do %>
                                        <div class="flex justify-between">
                                          <span><span class="font-semibold text-orange-600">FRAUD</span> &times; <%= fraud_count %> &nbsp;<span class="text-gray-400">(2 pts each)</span></span>
                                          <span class="font-semibold text-orange-600"><%= fraud_count * 2 %></span>
                                        </div>
                                      <% end %>
                                      <%= if review_count > 0 do %>
                                        <div class="flex justify-between">
                                          <span><span class="font-semibold text-yellow-700">REVIEW</span> &times; <%= review_count %> &nbsp;<span class="text-gray-400">(1 pt each)</span></span>
                                          <span class="font-semibold text-yellow-700"><%= review_count %></span>
                                        </div>
                                      <% end %>
                                      <%= if file.weighted_score == 0 do %>
                                        <div class="text-green-600">No weighted triggers — claim is clean</div>
                                      <% end %>
                                    </div>
                                  </div>

                                  <!-- Overall risk card -->
                                  <div class={[
                                    "rounded-lg p-4 border",
                                    cond do
                                      file.risk == "CriticalRisk" -> "bg-red-50 border-red-200"
                                      file.risk == "HighRisk" -> "bg-orange-50 border-orange-200"
                                      file.risk == "MediumRisk" -> "bg-yellow-50 border-yellow-200"
                                      true -> "bg-green-50 border-green-200"
                                    end
                                  ]}>
                                    <div class="flex justify-between items-center">
                                      <span class="text-sm font-bold text-gray-900">Overall Risk Assessment</span>
                                      <span class={[
                                        "px-3 py-1 rounded-full text-sm font-semibold",
                                        cond do
                                          file.risk == "CriticalRisk" -> "bg-red-100 text-red-800"
                                          file.risk == "HighRisk" -> "bg-orange-100 text-orange-800"
                                          file.risk == "MediumRisk" -> "bg-yellow-100 text-yellow-800"
                                          true -> "bg-green-100 text-green-800"
                                        end
                                      ]}>
                                        <%= file.risk %>
                                      </span>
                                    </div>
                                  </div>

                                  <!-- Triggered rules detail -->
                                  <%= if file.matched_results != [] do %>
                                    <div>
                                      <h5 class="text-xs font-semibold text-gray-800 uppercase mb-2">Triggered Rules</h5>
                                      <div class="space-y-2">
                                        <%= for mr <- file.matched_results do %>
                                          <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                                            <div class="flex items-start gap-2">
                                              <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                                              </svg>
                                              <div class="flex-1">
                                                <div class="flex items-center gap-2">
                                                  <span class="text-sm font-semibold text-red-800"><%= mr.rule %></span>
                                                  <span class={[
                                                    "px-1.5 py-0.5 text-xs font-bold rounded",
                                                    case mr.action do
                                                      "REJECT" -> "bg-red-200 text-red-800"
                                                      "FRAUD"  -> "bg-orange-200 text-orange-800"
                                                      "REVIEW" -> "bg-yellow-200 text-yellow-800"
                                                      _        -> "bg-gray-200 text-gray-700"
                                                    end
                                                  ]}>
                                                    <%= mr.action %>
                                                  </span>
                                                </div>
                                                <p class="text-xs text-red-700 mt-0.5"><%= mr.detail %></p>
                                              </div>
                                            </div>
                                          </div>
                                        <% end %>
                                      </div>
                                    </div>
                                  <% else %>
                                    <%= if batch.status == "failed" and file.status == "translated" do %>
                                      <div class="bg-gray-50 border border-gray-200 rounded-lg p-3">
                                        <span class="text-sm font-medium text-gray-600">Evaluation did not run — rule engine was unavailable when this batch was processed.</span>
                                      </div>
                                    <% else %>
                                      <div class="bg-green-50 border border-green-200 rounded-lg p-3">
                                        <span class="text-sm font-medium text-green-800">No rules triggered — claim is clean</span>
                                      </div>
                                    <% end %>
                                  <% end %>

                                </div>
                              </div>
                            </td>
                          </tr>
                        <% end %>
                      <% end %>
                    </tbody>
                  </table>
                  <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      </div>
      <% end %>
      </div>
    </div>

  </div>
</div>
