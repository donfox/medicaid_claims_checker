cabal-version:      2.4
name:               medicaid-claims-dsl
version:            0.1.0.0
synopsis:           DSL for healthcare claims fraud detection rules
description:        A domain-specific language allowing business analysts to write
                    predicate logic rules for examining healthcare claims to detect fraud.
-- All rights reserved; see LICENSE at the repository root.
license:            NONE
copyright:          (c) 2024-2026 Don Fox
author:             Don Fox
maintainer:         donfox1@mac.com
category:           Language
build-type:         Simple
extra-source-files: README.md

common warnings
    ghc-options: -Wall
    default-extensions: ImportQualifiedPost

library
    import:           warnings
    exposed-modules:  Claims.Syntax
                    , Claims.Parser
                    , Claims.SimpleEvaluator
                    , Claims.RuleEngine
                    , Claims.PolicyCombiner
                    , Claims.MLClient
                    , Claims.EvaluationContract
                    , Claims.RedundancyChecker
                    , Claims.ListenConfig
    build-depends:    base >=4.14 && <5
                    , parsec >= 3.1.14
                    , text >= 1.2.5
                    , containers >= 0.6.5
                    , aeson >= 2.0.3
                    , bytestring >= 0.11.0
                    , scientific >= 0.3.7
                    , vector >= 0.12.0
                    , time >= 1.9
                    , http-conduit >= 2.3
                    , http-client >= 0.7
                    , http-types >= 0.12.3
                    , regex-tdfa >= 1.3.1
    hs-source-dirs:   src
    default-language: Haskell2010

executable medicaid-claims-dsl-server
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >=4.14 && <5
                    , medicaid-claims-dsl
                    , aeson
                    , text
                    , bytestring
                    , warp >= 3.3.0
                    , warp-tls >= 3.3.0
                    , directory >= 1.3
                    , wai >= 3.2.0
                    , http-types >= 0.12.3
                    , time >= 1.9
                    , containers >= 0.6.5
                    , async >= 2.2
                    , network >= 3.1
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -O2 -with-rtsopts=-N

test-suite medicaid-claims-dsl-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    ParserProps
                    , Claims.Pretty
                    , BusinessRulesSpec
                    , ListenConfigSpec
    build-depends:    base >=4.14 && <5
                    , medicaid-claims-dsl
                    , hspec >= 2.9.0 && < 2.12
                    , QuickCheck >= 2.14
                    , text >= 1.2.5
                    , aeson
                    , time >= 1.9
