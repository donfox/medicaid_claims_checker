<div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
  <div class="mx-auto max-w-7xl">

    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div class="mb-4 p-4 bg-red-100 border border-red-300 rounded-lg">
        <p class="text-sm text-red-900 font-semibold"><%= Phoenix.Flash.get(@flash, :error) %></p>
      </div>
    <% end %>

    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div class="mb-4 p-4 bg-blue-100 border border-blue-300 rounded-lg">
        <p class="text-sm text-blue-900"><%= Phoenix.Flash.get(@flash, :info) %></p>
      </div>
    <% end %>

    <!-- Page Header -->
    <div class="mb-6 p-4 bg-white rounded-lg shadow-md">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Rule Catalogue</h1>
          <p class="mt-2 text-base text-gray-800 font-medium">Unified registry of all fraud detection rules and ML models</p>
        </div>
        <div class="flex gap-2">
          <a href={~p"/rules"} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium rounded-md border border-gray-300">
            Rule Editor
          </a>
          <a href={~p"/"} class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium rounded-md border border-gray-300">
            Claims Ingestion
          </a>
        </div>
      </div>
      <div class="mt-3 p-3 bg-blue-100 border border-blue-300 rounded-md">
        <p class="text-sm text-blue-900 font-medium">
          <strong>Default Rules</strong> are always-on (not editable). <strong>BA Rules</strong> are created by Business Analysts and can be toggled. <strong>ML Models</strong> are adaptive detection models.
        </p>
      </div>
    </div>

    <!-- Summary Stats -->
    <% counts = entry_counts(@entries) %>
    <div class="mb-6 grid grid-cols-3 sm:grid-cols-6 gap-3">
      <div class="bg-white shadow rounded-lg p-3 text-center">
        <p class="text-xl font-bold text-gray-900"><%= counts.total %></p>
        <p class="text-xs text-gray-700 mt-1">Total</p>
      </div>
      <div class="bg-white shadow rounded-lg p-3 text-center">
        <p class="text-xl font-bold text-indigo-700"><%= counts.default %></p>
        <p class="text-xs text-gray-700 mt-1">Default Rules</p>
      </div>
      <div class="bg-white shadow rounded-lg p-3 text-center">
        <p class="text-xl font-bold text-blue-700"><%= counts.ba %></p>
        <p class="text-xs text-gray-700 mt-1">BA Rules</p>
      </div>
      <div class="bg-white shadow rounded-lg p-3 text-center">
        <p class="text-xl font-bold text-purple-700"><%= counts.ml %></p>
        <p class="text-xs text-gray-700 mt-1">ML Models</p>
      </div>
      <div class="bg-white shadow rounded-lg p-3 text-center">
        <p class="text-xl font-bold text-green-700"><%= counts.active %></p>
        <p class="text-xs text-gray-700 mt-1">Active</p>
      </div>
      <div class="bg-white shadow rounded-lg p-3 text-center">
        <p class="text-xl font-bold text-orange-700"><%= counts.redundant %></p>
        <p class="text-xs text-gray-700 mt-1">Redundant</p>
      </div>
    </div>

    <!-- Add New Entry -->
    <div class="mb-6 bg-white shadow-md rounded-lg">
      <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">Add Entry</h2>
        <button
          type="button"
          phx-click="toggle_add_form"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md cursor-pointer"
        >
          <%= if @show_add_form, do: "Cancel", else: "+ New BA Rule / ML Model" %>
        </button>
      </div>

      <%= if @show_add_form do %>
        <!-- Redundancy Warning -->
        <%= if @redundancy_warning != [] do %>
          <div class="mx-4 mt-4 p-4 bg-orange-100 border border-orange-300 rounded-md">
            <p class="text-sm font-semibold text-orange-900">Possible Redundancy Detected</p>
            <p class="text-xs text-orange-800 mt-1">
              Similar entries already exist in the catalogue. Review them before saving to avoid duplicate rules.
            </p>
            <ul class="mt-2 space-y-1">
              <%= for entry <- @redundancy_warning do %>
                <li class="text-xs text-orange-900 font-medium">
                  &bull; <%= entry.name %> (<%= entry.entry_type %>)
                  <%= if entry.description && entry.description != "" do %>
                    &mdash; <%= entry.description %>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <div class="mt-3 flex gap-2">
              <button
                type="button"
                phx-click="confirm_save_redundant"
                class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white text-xs font-medium rounded cursor-pointer"
              >
                Save Anyway (Mark as Redundant)
              </button>
              <button
                type="button"
                phx-click="dismiss_redundancy_warning"
                class="px-3 py-1.5 bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium rounded cursor-pointer"
              >
                Go Back and Edit
              </button>
            </div>
          </div>
        <% end %>

        <.form
          for={%{}}
          phx-change="update_new_entry"
          phx-submit="save_new_entry"
          id="add-entry-form"
          class="p-4 space-y-4"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-900 mb-1">Entry Name <span class="text-red-600">*</span></label>
              <input
                name="entry[name]"
                value={@new_name}
                class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
                placeholder="e.g., HighRiskProvider"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-900 mb-1">Type <span class="text-red-600">*</span></label>
              <select
                name="entry[type]"
                class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
              >
                <option value="BA Rule" selected={@new_type == "BA Rule"}>BA Rule</option>
                <option value="ML Model" selected={@new_type == "ML Model"}>ML Model</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Description</label>
            <input
              name="entry[description]"
              value={@new_description}
              class="w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 bg-white"
              placeholder="Brief description of what this rule or model detects"
            />
          </div>

          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              name="entry[db_access]"
              value="true"
              checked={@new_db_access}
              id="new-db-access"
              class="h-4 w-4 text-blue-600 border-gray-400 rounded"
            />
            <label for="new-db-access" class="text-sm text-gray-900">
              Requires database access (queries provider/member data during evaluation)
            </label>
          </div>

          <%= if @form_error do %>
            <div class="p-3 bg-red-100 border border-red-300 rounded-md">
              <p class="text-sm text-red-900"><%= @form_error %></p>
            </div>
          <% end %>

          <div>
            <button
              type="submit"
              disabled={@new_name == ""}
              class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            >
              Add to Catalogue
            </button>
            <p class="mt-2 text-xs text-gray-600">
              Note: To write the DSL rule text for a BA Rule, go to the
              <a href={~p"/rules"} class="text-blue-600 hover:underline">Rule Editor</a>
              and save it to the catalog there.
            </p>
          </div>
        </.form>
      <% end %>
    </div>

    <!-- Filter Tabs -->
    <div class="mb-4 flex gap-2 flex-wrap">
      <%= for tab <- ["All", "Default Rule", "BA Rule", "ML Model"] do %>
        <button
          type="button"
          phx-click="set_filter"
          phx-value-type={tab}
          class={"px-4 py-1.5 text-sm font-medium rounded-full border cursor-pointer #{if @filter_type == tab, do: "bg-blue-600 text-white border-blue-600", else: "bg-white text-gray-800 border-gray-300 hover:bg-gray-100"}"}
        >
          <%= tab %>
          <%= case tab do
            "All" -> "(#{counts.total})"
            "Default Rule" -> "(#{counts.default})"
            "BA Rule" -> "(#{counts.ba})"
            "ML Model" -> "(#{counts.ml})"
          end %>
        </button>
      <% end %>
    </div>

    <!-- Entries Table -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <%= if filtered_entries(@entries, @filter_type) == [] do %>
        <div class="p-8 text-center text-sm text-gray-700">
          No entries found
          <%= if @filter_type != "All", do: "for type \"#{@filter_type}\"", else: "" %>.
          <%= if @filter_type == "BA Rule" or @filter_type == "All" do %>
            Use the <strong>+ New BA Rule / ML Model</strong> button above to add entries.
          <% end %>
        </div>
      <% else %>
        <table class="w-full text-sm">
          <caption class="sr-only">Rule Catalogue</caption>
          <thead class="bg-gray-100 border-b border-gray-300">
            <tr>
              <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-800">Name</th>
              <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-800">Description</th>
              <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-800">Type</th>
              <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-800">Status</th>
              <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-800">Flags</th>
              <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-800">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <%= for entry <- filtered_entries(@entries, @filter_type) do %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-gray-900">
                  <%= entry.name %>
                </td>
                <td class="px-4 py-3 text-gray-700 text-xs max-w-xs">
                  <%= entry.description || "" %>
                </td>
                <td class="px-4 py-3">
                  <%= case entry.entry_type do %>
                    <% "Default Rule" -> %>
                      <span class="px-2 py-0.5 text-xs bg-indigo-100 text-indigo-800 rounded font-medium">Default Rule</span>
                    <% "BA Rule" -> %>
                      <span class="px-2 py-0.5 text-xs bg-blue-100 text-blue-800 rounded font-medium">BA Rule</span>
                    <% "ML Model" -> %>
                      <span class="px-2 py-0.5 text-xs bg-purple-100 text-purple-800 rounded font-medium">ML Model</span>
                    <% _ -> %>
                      <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-800 rounded font-medium"><%= entry.entry_type %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <%= if entry.status == "Active" do %>
                    <span class="px-2 py-0.5 text-xs bg-green-100 text-green-900 rounded font-medium">Active</span>
                  <% else %>
                    <span class="px-2 py-0.5 text-xs bg-gray-200 text-gray-700 rounded font-medium">Inactive</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <%= if entry.redundant do %>
                      <span class="px-1.5 py-0.5 text-[10px] bg-orange-100 text-orange-800 rounded">Redundant</span>
                    <% end %>
                    <%= if entry.db_access do %>
                      <span class="px-1.5 py-0.5 text-[10px] bg-yellow-100 text-yellow-800 rounded">DB Access</span>
                    <% end %>
                    <%= if not entry.editable do %>
                      <span class="px-1.5 py-0.5 text-[10px] bg-gray-100 text-gray-700 rounded">Read-only</span>
                    <% end %>
                    <%= if not entry.removable do %>
                      <span class="px-1.5 py-0.5 text-[10px] bg-gray-100 text-gray-700 rounded">Protected</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-2">
                    <%= if entry.editable do %>
                      <button
                        type="button"
                        phx-click="toggle_status"
                        phx-value-id={entry.id}
                        class="px-3 py-1 text-xs font-medium rounded bg-indigo-100 hover:bg-indigo-200 text-indigo-800 cursor-pointer"
                      >
                        <%= if entry.status == "Active", do: "Deactivate", else: "Activate" %>
                      </button>
                    <% else %>
                      <span class="px-3 py-1 text-xs text-gray-400">Always On</span>
                    <% end %>

                    <%= if entry.removable do %>
                      <button
                        type="button"
                        phx-click="delete_entry"
                        phx-value-id={entry.id}
                        class="px-3 py-1 text-xs font-medium rounded bg-red-100 hover:bg-red-200 text-red-800 cursor-pointer"
                        data-confirm="Remove this entry from the catalogue?"
                      >
                        Remove
                      </button>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>

    <!-- Processing Flow Note -->
    <div class="mt-8 p-4 bg-gray-50 border border-gray-300 rounded-lg">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Processing Flow</h3>
      <ol class="text-xs text-gray-800 space-y-1 list-decimal pl-4">
        <li>All active <strong>Default Rules</strong> are evaluated first for every claim (regulatory, safety, and audit checks).</li>
        <li>All active <strong>BA Rules</strong> and <strong>ML Models</strong> are then evaluated in order.</li>
        <li>Rules and models flagged as <strong>DB Access</strong> may query provider and member data during evaluation.</li>
        <li>Redundant entries are flagged for BA review but still evaluated unless deactivated.</li>
      </ol>
    </div>

  </div>
</div>
