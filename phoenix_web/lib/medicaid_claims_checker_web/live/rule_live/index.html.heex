<div class="px-4 py-6 sm:px-6 sm:py-8 lg:px-8 xl:px-28 xl:py-10">
  <div class="mx-auto max-w-7xl">
    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div role="alert" class="mb-4 p-4 bg-red-100 border border-red-300 rounded-lg">
        <p class="text-sm text-red-900 font-semibold"><%= Phoenix.Flash.get(@flash, :error) %></p>
      </div>
    <% end %>

    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div role="alert" aria-live="polite" class="mb-4 p-4 bg-blue-100 border border-blue-300 rounded-lg">
        <p class="text-sm text-blue-900"><%= Phoenix.Flash.get(@flash, :info) %></p>
      </div>
    <% end %>

    <%= if @batch_notification do %>
      <div role="alert" class={[
        "mb-4 rounded-lg border overflow-hidden",
        if(@batch_notification.type == :completed, do: "bg-green-50 border-green-300", else: "bg-red-50 border-red-300")
      ]}>
        <div class="p-4 flex items-start justify-between">
          <div class="flex items-start gap-3 flex-1">
            <div class={[
              "flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center mt-0.5",
              if(@batch_notification.type == :completed, do: "bg-green-200", else: "bg-red-200")
            ]}>
              <%= if @batch_notification.type == :completed do %>
                <svg aria-hidden="true" class="w-5 h-5 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              <% else %>
                <svg aria-hidden="true" class="w-5 h-5 text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              <% end %>
            </div>
            <div class="flex-1">
              <%= if @batch_notification.type == :completed do %>
                <p class="text-sm font-semibold text-green-900">
                  Batch "<%= @batch_notification.batch_id %>" evaluated
                </p>
                <p class="text-sm text-green-800 mt-1">
                  <%= @batch_notification.total %> claims processed
                  — <%= @batch_notification.flagged %> flagged, <%= @batch_notification.clean %> clean
                </p>
                <button
                  phx-click="toggle_notification_details"
                  aria-expanded={to_string(@batch_notification.expanded)}
                  class="mt-2 text-xs font-medium text-green-700 hover:text-green-900 underline"
                >
                  <%= if @batch_notification.expanded, do: "Hide details", else: "Show claim details" %>
                </button>
              <% else %>
                <p class="text-sm font-semibold text-red-900">
                  Batch "<%= @batch_notification.batch_id %>" failed
                </p>
                <p class="text-sm text-red-800 mt-1"><%= @batch_notification.reason %></p>
              <% end %>
            </div>
          </div>
          <button
            phx-click="dismiss_batch_notification"
            aria-label="Dismiss notification"
            class="flex-shrink-0 ml-4 text-gray-400 hover:text-gray-800"
          >
            <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%= if @batch_notification.type == :completed && @batch_notification.expanded do %>
          <div class="border-t border-green-200 px-4 py-3 bg-green-50/50">
            <table class="w-full text-sm">
              <caption class="sr-only">Evaluated claims in batch</caption>
              <thead>
                <tr class="text-left text-xs font-semibold text-green-800 uppercase">
                  <th scope="col" class="pb-2 pr-4">Filename</th>
                  <th scope="col" class="pb-2 pr-4">Status</th>
                  <th scope="col" class="pb-2 pr-4">Risk</th>
                  <th scope="col" class="pb-2 pr-4">Rules Matched</th>
                  <th scope="col" class="pb-2">Details</th>
                </tr>
              </thead>
              <tbody>
                <%= for file <- @batch_notification.files do %>
                  <tr class="border-t border-green-100">
                    <td class="py-2 pr-4 font-medium text-gray-900"><%= file.filename %></td>
                    <td class="py-2 pr-4">
                      <span class={[
                        "px-2 py-0.5 text-xs font-medium rounded-full",
                        if(file.status == "fraudulent", do: "bg-red-100 text-red-800", else: "bg-green-100 text-green-900")
                      ]}>
                        <%= file.status %>
                      </span>
                    </td>
                    <td class="py-2 pr-4">
                      <span class={[
                        "text-xs font-semibold",
                        cond do
                          file.risk == "CriticalRisk" -> "text-red-700"
                          file.risk == "HighRisk" -> "text-orange-600"
                          file.risk == "MediumRisk" -> "text-yellow-700"
                          true -> "text-green-700"
                        end
                      ]}>
                        <%= file.risk %>
                      </span>
                    </td>
                    <td class="py-2 pr-4 text-gray-800"><%= file.matched_rules %></td>
                    <td class="py-2 text-xs text-gray-800">
                      <%= for mr <- file.matched_results do %>
                        <div><span class="font-medium"><%= mr.rule %></span></div>
                      <% end %>
                      <%= if file.matched_results == [] do %>
                        <span class="text-green-600">No rules triggered</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mb-6 p-6 bg-white rounded-lg shadow-md">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-900">Claims Integrity Engine</h1>
        <div class="flex gap-2">
          <a href={~p"/"} class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-md">
            Dashboard
          </a>
        </div>
      </div>
      <p class="mt-2 text-base text-gray-800 font-medium">Write integrity rules using DSL against healthcare claims</p>
    </div>


    <div class="mb-6 p-6 bg-blue-100 border border-blue-200 rounded-lg shadow-md">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-900">Business Rule Catalog</h2>
        <button
          type="button"
          phx-click="toggle_dsl_reference"
          aria-expanded={to_string(@show_dsl_reference)}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md border border-blue-300 bg-blue-50 hover:bg-blue-100 text-blue-700 cursor-pointer"
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          DSL Reference
        </button>
      </div>
      <p class="mt-1 text-sm text-gray-800">Save reusable rules for BA teams, activate/deactivate them, and apply active rules automatically during claim processing.</p>

      <details class="mt-4 group/form">
        <summary class="px-3 py-2 bg-blue-50 border border-blue-200 rounded-md text-sm font-semibold text-blue-800 cursor-pointer select-none flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-blue-500 transition-transform group-open/form:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          Create / Edit Rule
        </summary>
      <.form for={%{}} phx-change="update_catalog_rule" phx-submit="save_catalog_rule" id="catalog-rule-form" class="mt-3">
        <%= if @selected_catalog_rule_id do %>
          <%= if @selected_catalog_rule_type in ["Default Rule", "ML Model"] do %>
            <div class="mb-3 p-3 bg-indigo-50 border border-indigo-300 rounded-md">
              <p class="text-sm text-indigo-900 font-medium"><%= @selected_catalog_rule_type %> — read-only system rule</p>
            </div>
          <% else %>
            <div class="mb-3 p-3 bg-blue-100 border border-blue-300 rounded-md">
              <p class="text-sm text-blue-900 font-medium">Editing BA Rule</p>
            </div>
          <% end %>
        <% end %>

        <div>
          <label for="catalog-rule-name" class="block text-sm font-medium text-gray-900 mb-1">Rule Name</label>
          <input
            id="catalog-rule-name"
            name="catalog[name]"
            value={@catalog_rule_name}
            readonly={@selected_catalog_rule_type in ["Default Rule", "ML Model"]}
            aria-required="true"
            class={"w-full px-3 py-2 border border-gray-400 rounded-md text-sm text-gray-900 #{if @selected_catalog_rule_type in ["Default Rule", "ML Model"], do: "bg-gray-100 cursor-default", else: "bg-white"}"}
            placeholder="e.g., HighValueReview"
            phx-debounce="300"
          />
        </div>

        <div class="mt-3">
          <div class="flex items-center justify-between mb-1">
            <label for="catalog-rule-text" class="text-sm font-medium text-gray-900">Rule Text</label>
            <%= if @catalog_rule_text != "" do %>
              <button
                type="button"
                phx-click="clear_catalog_rule"
                class="px-3 py-1 bg-gray-500 hover:bg-gray-600 text-white rounded text-xs font-medium cursor-pointer"
              >
                Clear
              </button>
            <% end %>
          </div>
          <textarea
            id="catalog-rule-text"
            name="catalog[text]"
            readonly={@selected_catalog_rule_type in ["Default Rule", "ML Model"]}
            aria-required="true"
            class={"w-full h-40 p-2 font-mono text-xs border border-gray-400 rounded-md text-gray-900 #{if @selected_catalog_rule_type in ["Default Rule", "ML Model"], do: "bg-gray-100 cursor-default", else: "bg-white"}"}
            placeholder="Paste one or more RULE...END blocks"
            phx-debounce="300"
          ><%= @catalog_rule_text %></textarea>
        </div>

        <%= if @catalog_rule_text != "" && @selected_catalog_rule_type not in ["Default Rule", "ML Model"] do %>
          <%= if @catalog_parse_error do %>
            <div role="alert" class="mt-3 p-3 bg-red-100 border border-red-300 rounded-md">
              <p class="text-sm text-red-900 font-semibold">Rule syntax issue</p>
              <p class="text-xs text-red-800 mt-1 whitespace-pre-wrap"><%= @catalog_parse_error %></p>
            </div>
          <% else %>
            <div role="alert" class="mt-3 p-3 bg-green-100 border border-green-300 rounded-md">
              <p class="text-sm text-green-900 font-semibold">✓ Rule syntax is valid</p>
            </div>
          <% end %>
        <% end %>

        <%= if @catalog_error do %>
          <div role="alert" class="mt-3 p-3 bg-red-100 border border-red-300 rounded-md">
            <p class="text-sm text-red-900"><%= @catalog_error %></p>
          </div>
        <% end %>

        <%= if @redundancy_matches != [] do %>
          <div class="mt-3 space-y-3">
            <%= for {tier, matches} <- group_redundancy_matches(@redundancy_matches) do %>
              <div class={[
                "p-4 rounded-md border",
                tier == :conflict && "bg-red-50 border-red-300",
                tier == :redundant && "bg-yellow-50 border-yellow-300",
                tier == :overlap && "bg-blue-50 border-blue-300"
              ]}>
                <p class={[
                  "text-sm font-semibold",
                  tier == :conflict && "text-red-900",
                  tier == :redundant && "text-yellow-900",
                  tier == :overlap && "text-blue-900"
                ]}>
                  <%= case tier do %>
                    <% :conflict -> %>Action Conflict
                    <% :redundant -> %>Redundant Rule
                    <% :overlap -> %>Partial Overlap — Informational
                  <% end %>
                </p>
                <p class={[
                  "text-xs mt-1",
                  tier == :conflict && "text-red-800",
                  tier == :redundant && "text-yellow-800",
                  tier == :overlap && "text-blue-700"
                ]}>
                  <%= case tier do %>
                    <% :conflict -> %>This rule conflicts with an existing rule. Both match the same claims but may prescribe different actions.
                    <% :redundant -> %>This rule is already covered by an existing rule with the same action. It will work but is unnecessary.
                    <% :overlap -> %>This rule shares some field constraints with an existing rule. This may be intentional.
                  <% end %>
                </p>
                <ul class="mt-2 space-y-2">
                  <%= for match <- matches do %>
                    <li class={[
                      "text-xs border-l-2 pl-2",
                      tier == :conflict && "text-red-900 border-red-400",
                      tier == :redundant && "text-yellow-900 border-yellow-400",
                      tier == :overlap && "text-blue-900 border-blue-300"
                    ]}>
                      <span class="font-semibold"><%= redundancy_level_label(match["matchLevel"]) %></span>
                      with <span class="font-mono font-semibold"><%= match["matchRuleName"] %></span>:
                      <%= match["matchExplanation"] %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="flex gap-2 mt-2">
              <button type="button" phx-click="dismiss_redundancy_warning"
                class={"px-4 py-2.5 text-white rounded-md text-sm font-medium cursor-pointer " <> if(redundancy_has_conflicts?(@redundancy_matches), do: "bg-red-600 hover:bg-red-700", else: "bg-yellow-600 hover:bg-yellow-700")}>
                Save Anyway
              </button>
              <button type="button" phx-click="cancel_redundancy_save"
                class="px-4 py-2.5 bg-gray-600 hover:bg-gray-700 text-white rounded-md text-sm font-medium cursor-pointer">
                Cancel
              </button>
            </div>
          </div>
        <% end %>

        <div class="mt-3 flex gap-2">
          <%= if @selected_catalog_rule_id do %>
            <%= if @selected_catalog_rule_type not in ["Default Rule", "ML Model"] do %>
              <button
                type="submit"
                disabled={@catalog_rule_name == "" || @catalog_rule_text == "" || @catalog_parse_error != nil}
                class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              >
                Save Edits
              </button>
            <% end %>
            <button
              type="button"
              phx-click="dismiss_selected_catalog_rule"
              class="px-4 py-2.5 bg-gray-600 hover:bg-gray-700 text-white rounded-md text-sm font-medium cursor-pointer"
            >
              Dismiss
            </button>
          <% else %>
            <button
              type="submit"
              disabled={@catalog_rule_name == "" || @catalog_rule_text == "" || @catalog_parse_error != nil}
              class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            >
              Save Rule to Catalog
            </button>
          <% end %>
        </div>
      </.form>
      </details>

      <% counts = catalog_counts(@catalog_rules) %>

      <!-- Summary Stats -->
      <div class="mt-4 grid grid-cols-3 sm:grid-cols-6 gap-2">
        <div class="bg-gray-50 border border-gray-200 rounded px-2 py-1.5 text-center">
          <p class="text-lg font-bold text-gray-900"><%= counts.total %></p>
          <p class="text-[10px] text-gray-800">Total</p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded px-2 py-1.5 text-center">
          <p class="text-lg font-bold text-indigo-700"><%= counts.default %></p>
          <p class="text-[10px] text-gray-800">Default</p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded px-2 py-1.5 text-center">
          <p class="text-lg font-bold text-blue-700"><%= counts.ba %></p>
          <p class="text-[10px] text-gray-800">BA Rules</p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded px-2 py-1.5 text-center">
          <p class="text-lg font-bold text-purple-700"><%= counts.ml %></p>
          <p class="text-[10px] text-gray-800">ML Models</p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded px-2 py-1.5 text-center">
          <p class="text-lg font-bold text-green-700"><%= counts.active %></p>
          <p class="text-[10px] text-gray-800">Active</p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded px-2 py-1.5 text-center">
          <p class="text-lg font-bold text-orange-700"><%= counts.redundant %></p>
          <p class="text-[10px] text-gray-800">Redundant</p>
        </div>
      </div>

      <%= for {type_key, label, color, badge_class, count} <- [
        {"BA Rule", "BA Created Rules", "blue", "bg-blue-100 text-blue-800", counts.ba},
        {"Default Rule", "Default Rules", "indigo", "bg-indigo-100 text-indigo-800", counts.default},
        {"ML Model", "ML Models", "purple", "bg-purple-100 text-purple-800", counts.ml}
      ] do %>
        <% type_rules = filtered_catalog_rules(@catalog_rules, type_key) %>
        <% type_active = Enum.count(type_rules, &(&1.status == "Active")) %>
        <details class={"mt-3 group"}>
          <summary class={"px-3 py-2 bg-gray-50 border border-gray-200 rounded-md text-sm font-semibold text-gray-800 cursor-pointer select-none flex items-center gap-2 [&::-webkit-details-marker]:hidden list-none"}>
            <svg aria-hidden="true" class={"w-4 h-4 text-#{color}-500 transition-transform group-open:rotate-90"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class={badge_class <> " px-1.5 py-0.5 text-[10px] rounded font-medium"}><%= type_key %></span>
            <%= label %>
            <span class="text-xs font-normal text-gray-800">
              — <%= count %> total<%= if type_key != "Default Rule", do: ", #{type_active} active" %>
            </span>
          </summary>

          <div class="mt-2 border border-gray-300 rounded-md overflow-hidden">
            <%= if type_rules == [] do %>
              <div class="p-4 text-center text-sm text-gray-800">
                No <%= String.downcase(label) %> found.
              </div>
            <% else %>
              <div class="divide-y divide-gray-200">
                <%= for entry <- type_rules do %>
                  <div
                    id={"catalog-entry-#{entry.id}"}
                    class={"p-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 #{if @selected_catalog_rule_id == entry.id, do: "bg-blue-50", else: ""}"}
                  >
                    <button type="button" phx-click="select_catalog_rule" phx-value-id={entry.id} class="text-left w-full">
                      <div class="flex items-center gap-1.5 flex-wrap">
                        <p class="text-sm font-semibold text-gray-900"><%= entry.name %></p>
                        <!-- Status -->
                        <%= if entry.entry_type == "Default Rule" do %>
                          <span class="px-1.5 py-0.5 text-[10px] bg-green-100 text-green-900 rounded font-medium">Always On</span>
                        <% else %>
                          <%= if entry.status == "Active" do %>
                            <span class="px-1.5 py-0.5 text-[10px] bg-green-100 text-green-900 rounded font-medium">Active</span>
                          <% else %>
                            <span class="px-1.5 py-0.5 text-[10px] bg-gray-200 text-gray-800 rounded font-medium">Inactive</span>
                          <% end %>
                        <% end %>
                        <!-- Selected -->
                        <%= if @selected_catalog_rule_id == entry.id do %>
                          <span class="px-1.5 py-0.5 text-[10px] bg-blue-200 text-blue-900 rounded font-medium">Selected</span>
                        <% end %>
                        <!-- Flags -->
                        <%= if entry.redundant do %>
                          <span class="px-1.5 py-0.5 text-[10px] bg-orange-100 text-orange-800 rounded">Redundant</span>
                        <% end %>
                        <%= if entry.db_access do %>
                          <span class="px-1.5 py-0.5 text-[10px] bg-yellow-100 text-yellow-800 rounded">DB Access</span>
                        <% end %>
                        <%= if not entry.editable do %>
                          <span class="px-1.5 py-0.5 text-[10px] bg-gray-100 text-gray-800 rounded">Read-only</span>
                        <% end %>
                      </div>
                      <%= if entry.description && entry.description != "" do %>
                        <p class="mt-1 text-xs text-gray-800"><%= entry.description %></p>
                      <% end %>
                    </button>
                    <div class="flex gap-2 shrink-0">
                      <%= if entry.editable do %>
                        <button type="button" phx-click="toggle_catalog_rule_active" phx-value-id={entry.id} class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded text-xs font-medium cursor-pointer">
                          <%= if entry.status == "Active", do: "Deactivate", else: "Activate" %>
                        </button>
                        <%= if entry.removable do %>
                          <button type="button" phx-click="delete_catalog_rule" phx-value-id={entry.id} class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-medium cursor-pointer" data-confirm="Remove this rule from the catalogue?">
                            Remove
                          </button>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <!-- DSL Reference Guide -->
    <%= if @show_dsl_reference do %>
      <div class="mb-6 bg-amber-100 border border-amber-200 rounded-lg shadow-md">
        <div class="px-6 py-4 border-b border-amber-200 flex items-center justify-between">
          <h2 class="text-xl font-semibold text-gray-900">Business Rules Syntax Guide</h2>
          <button type="button" phx-click="toggle_dsl_reference" aria-label="Close DSL reference" class="text-gray-400 hover:text-gray-800 cursor-pointer">
            <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="p-6 space-y-6">

          <!-- Rule Structure -->
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Rule Structure</h3>
            <p class="text-xs text-gray-800 mb-2">Every rule follows this pattern. Use one or more <code class="bg-gray-100 px-1 rounded">RULE...END</code> blocks per editor run. Add comments with <code class="bg-gray-100 px-1 rounded">--</code>.</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Template</p>
                <pre class="text-xs bg-gray-50 p-3 rounded border border-gray-300 overflow-x-auto text-gray-900"><code>RULE &lt;rule_name&gt;
DESCRIPTION "&lt;description&gt;"
WHEN &lt;predicate&gt;
THEN &lt;action&gt;
END</code></pre>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Example</p>
                <pre class="text-xs bg-gray-50 p-3 rounded border border-gray-300 overflow-x-auto text-gray-900"><code>RULE high_claim_amount
DESCRIPTION "Flag unusually high claims"
WHEN 2300.CLM.claim_amount &gt; 50000.0
THEN FLAG_FRAUD "Exceeds $50,000 threshold"
END</code></pre>
              </div>
            </div>
          </div>

          <!-- Conditions -->
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Conditions (WHEN)</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Comparison Operators</p>
                <table class="text-xs w-full bg-white rounded border border-gray-300">
                  <tbody>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">=  !=</td><td class="p-1.5 text-gray-800">Equals / Not equals</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">&gt;  &lt;</td><td class="p-1.5 text-gray-800">Greater / Less than</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">&gt;=  &lt;=</td><td class="p-1.5 text-gray-800">Greater/Less or equal</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">IS NULL</td><td class="p-1.5 text-gray-800">Field has no value</td></tr>
                    <tr><td class="p-1.5 font-mono text-gray-900">IS NOT NULL</td><td class="p-1.5 text-gray-800">Field has a value</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Logical &amp; String Operators</p>
                <table class="text-xs w-full bg-white rounded border border-gray-300">
                  <tbody>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">AND</td><td class="p-1.5 text-gray-800">Both must be true</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">OR</td><td class="p-1.5 text-gray-800">At least one true</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">NOT</td><td class="p-1.5 text-gray-800">Negates predicate</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">CONTAINS</td><td class="p-1.5 text-gray-800">Text contains</td></tr>
                    <tr><td class="p-1.5 font-mono text-gray-900">MATCHES</td><td class="p-1.5 text-gray-800">Regex (future)</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Quantifiers</p>
                <table class="text-xs w-full bg-white rounded border border-gray-300">
                  <tbody>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">EXISTS</td><td class="p-1.5 text-gray-800">At least one match</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">FORALL</td><td class="p-1.5 text-gray-800">All items match</td></tr>
                    <tr><td class="p-1.5 font-mono text-gray-900">COUNT()</td><td class="p-1.5 text-gray-800">Number of items</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Actions (THEN)</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="p-2 bg-gray-50 rounded border border-gray-200">
                <p class="font-mono text-xs font-semibold text-gray-900">FLAG_FRAUD</p>
                <p class="text-[10px] text-gray-800 mt-1">Flag as potentially fraudulent</p>
                <code class="text-[10px] text-gray-800">FLAG_FRAUD "reason"</code>
              </div>
              <div class="p-2 bg-gray-50 rounded border border-gray-200">
                <p class="font-mono text-xs font-semibold text-gray-900">REJECT</p>
                <p class="text-[10px] text-gray-800 mt-1">Reject the claim</p>
                <code class="text-[10px] text-gray-800">REJECT "reason"</code>
              </div>
              <div class="p-2 bg-gray-50 rounded border border-gray-200">
                <p class="font-mono text-xs font-semibold text-gray-900">REQUIRE_REVIEW</p>
                <p class="text-[10px] text-gray-800 mt-1">Flag for manual review</p>
                <code class="text-[10px] text-gray-800">REQUIRE_REVIEW "note"</code>
              </div>
              <div class="p-2 bg-gray-50 rounded border border-gray-200">
                <p class="font-mono text-xs font-semibold text-gray-900">RISK_SCORE</p>
                <p class="text-[10px] text-gray-800 mt-1">Assign risk score 0-100</p>
                <code class="text-[10px] text-gray-800">RISK_SCORE 75</code>
              </div>
            </div>
            <p class="text-xs text-gray-800 mt-2">Combine multiple: <code class="bg-gray-100 px-1 rounded text-[10px]">[FLAG_FRAUD "reason", RISK_SCORE 85, REQUIRE_REVIEW "note"]</code></p>
          </div>

          <!-- Field References -->
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Field References</h3>
            <p class="text-xs text-gray-800 mb-2">
              Claims follow: <span class="font-semibold">Interchange</span> &rarr; <span class="font-semibold">Functional Group</span> &rarr; <span class="font-semibold">Transaction</span> &rarr; <span class="font-semibold">Loops</span> &rarr; <span class="font-semibold">Segments</span> &rarr; <span class="font-semibold">Elements</span>
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Common Loops (837P)</p>
                <table class="text-xs w-full bg-white rounded border border-gray-300">
                  <tbody>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">2300</td><td class="p-1.5 text-gray-800">Claim Info</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">2400</td><td class="p-1.5 text-gray-800">Service Line</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">2010</td><td class="p-1.5 text-gray-800">Provider/Patient</td></tr>
                    <tr><td class="p-1.5 font-mono font-semibold text-gray-900">2320</td><td class="p-1.5 text-gray-800">Other Subscriber</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Common Segments</p>
                <table class="text-xs w-full bg-white rounded border border-gray-300">
                  <tbody>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">CLM</td><td class="p-1.5 text-gray-800">Claim</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">SV1</td><td class="p-1.5 text-gray-800">Professional Service</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">DTP</td><td class="p-1.5 text-gray-800">Date/Time</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono font-semibold text-gray-900">HI</td><td class="p-1.5 text-gray-800">Diagnosis Code</td></tr>
                    <tr><td class="p-1.5 font-mono font-semibold text-gray-900">NM1</td><td class="p-1.5 text-gray-800">Name</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Reference Formats</p>
                <table class="text-xs w-full bg-white rounded border border-gray-300">
                  <tbody>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">field_name</td><td class="p-1.5 text-gray-800">Simple field</td></tr>
                    <tr class="border-b border-gray-200"><td class="p-1.5 font-mono text-gray-900">CLM.claim_amount</td><td class="p-1.5 text-gray-800">Segment.field</td></tr>
                    <tr><td class="p-1.5 font-mono text-gray-900">2300.CLM.claim_amount</td><td class="p-1.5 text-gray-800">Loop.segment.field</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Examples -->
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Examples</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div class="p-3 bg-gray-50 rounded border border-gray-200">
                <p class="text-xs font-medium text-gray-800 mb-1">Missing Required Field</p>
                <pre class="text-[11px] bg-white p-2 rounded border border-gray-300 overflow-x-auto text-gray-900"><code>RULE missing_diagnosis "Reject without diagnosis"
WHEN 2300.HI.diagnosis_code IS NULL
THEN REJECT "Diagnosis code required";</code></pre>
              </div>
              <div class="p-3 bg-gray-50 rounded border border-gray-200">
                <p class="text-xs font-medium text-gray-800 mb-1">Complex Pattern with AND</p>
                <pre class="text-[11px] bg-white p-2 rounded border border-gray-300 overflow-x-auto text-gray-900"><code>RULE excessive_charges "High-value services"
WHEN COUNT(2400) &gt; 10
     AND FORALL 2400 WHERE 2400.SV1.line_charge &gt; 500.0
THEN [FLAG_FRAUD "Excessive billing", RISK_SCORE 80];</code></pre>
              </div>
              <div class="p-3 bg-gray-50 rounded border border-gray-200">
                <p class="text-xs font-medium text-gray-800 mb-1">Unbundling Detection</p>
                <pre class="text-[11px] bg-white p-2 rounded border border-gray-300 overflow-x-auto text-gray-900"><code>RULE unbundling_check "Detect unbundled E&amp;M codes"
WHEN EXISTS 2400.SV1 WHERE procedure_code = "99213"
     AND EXISTS 2400.SV1 WHERE procedure_code = "99214"
THEN FLAG_FRAUD "Possible unbundling";</code></pre>
              </div>
              <div class="p-3 bg-gray-50 rounded border border-gray-200">
                <p class="text-xs font-medium text-gray-800 mb-1">Provider Validation</p>
                <pre class="text-[11px] bg-white p-2 rounded border border-gray-300 overflow-x-auto text-gray-900"><code>RULE provider_status "Check provider eligibility"
WHEN 2010.NM1.provider_status = "suspended"
     OR 2010.NM1.provider_status = "terminated"
THEN REJECT "Provider not eligible";</code></pre>
              </div>
            </div>
          </div>

          <!-- Best Practices & Risk Scores -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h3 class="font-semibold text-sm text-gray-900 mb-2">Best Practices</h3>
              <ul class="text-xs text-gray-900 list-disc pl-5 space-y-1">
                <li>Use descriptive names: <code class="bg-gray-100 px-1 rounded">high_claim_amount</code> not <code class="bg-gray-100 px-1 rounded">rule1</code></li>
                <li>Write clear descriptions that explain the business intent</li>
                <li>Be specific with thresholds — too high won't catch fraud</li>
                <li>Combine related checks into one rule instead of many separate ones</li>
              </ul>
            </div>
            <div>
              <h3 class="font-semibold text-sm text-gray-900 mb-2">Risk Score Ranges</h3>
              <table class="text-xs w-full bg-white rounded border border-gray-300">
                <tbody>
                  <tr class="border-b border-gray-200"><td class="p-1.5 font-semibold text-gray-900">0-30</td><td class="p-1.5 text-gray-800">Low risk, informational</td></tr>
                  <tr class="border-b border-gray-200"><td class="p-1.5 font-semibold text-yellow-700">31-60</td><td class="p-1.5 text-gray-800">Medium, review recommended</td></tr>
                  <tr class="border-b border-gray-200"><td class="p-1.5 font-semibold text-orange-700">61-85</td><td class="p-1.5 text-gray-800">High, review required</td></tr>
                  <tr><td class="p-1.5 font-semibold text-red-700">86-100</td><td class="p-1.5 text-gray-800">Critical, immediate action</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Troubleshooting -->
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Troubleshooting</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Parse Errors</p>
                <ul class="text-xs text-gray-900 list-disc pl-5 space-y-0.5">
                  <li>Check for missing semicolons</li>
                  <li>Ensure quotes are balanced</li>
                  <li>Verify keyword spelling (RULE, WHEN, THEN)</li>
                  <li>Check parentheses are matched</li>
                </ul>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800 mb-1">Runtime Errors</p>
                <ul class="text-xs text-gray-900 list-disc pl-5 space-y-0.5">
                  <li>Verify field names match claim JSON structure</li>
                  <li>Use numbers for numeric comparisons, not strings</li>
                  <li>Check loop IDs are correct (2300, 2400, etc.)</li>
                </ul>
              </div>
            </div>
          </div>

        </div>
      </div>
    <% end %>



  </div>
</div>
