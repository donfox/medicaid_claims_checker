cabal-version:      2.4
name:               medicaid-claims-dsl
version:            0.1.0.0
synopsis:           DSL for healthcare claims fraud detection rules
description:        A domain-specific language allowing business analysts to write
                    predicate logic rules for examining healthcare claims to detect fraud.
license:            NONE
author:             Don Fox
maintainer:         your.donfox1@mac.com
category:           Language
build-type:         Simple
extra-source-files: README.md

common warnings
    ghc-options: -Wall -O0
    default-extensions: ImportQualifiedPost
    -- Disable optimizations for faster development builds

library
    import:           warnings
    exposed-modules:  Claims.Syntax
                    , Claims.Parser
                    , Claims.SimpleEvaluator
                    , Claims.RuleEngine
                    , Claims.RuleCache
                    , Claims.PolicyCombiner
                    , Claims.MLClient
                    , Claims.EvaluationContract
                    , Claims.RedundancyChecker
    build-depends:    base >=4.14 && <5
                    , parsec >= 3.1.14
                    , text >= 1.2.5
                    , containers >= 0.6.5
                    , aeson >= 2.0.3
                    , bytestring >= 0.11.0
                    , scientific >= 0.3.7
                    , vector >= 0.12.0
                    , stm >= 2.5
                    , time >= 1.9
                    , http-conduit >= 2.3
                    , http-client >= 0.7
                    , http-types >= 0.12.3
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options: -threaded

executable medicaid-claims-dsl-server
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >=4.14 && <5
                    , medicaid-claims-dsl
                    , aeson
                    , text
                    , bytestring
                    , warp >= 3.3.0
                    , wai >= 3.2.0
                    , http-types >= 0.12.3
                    , stm >= 2.5
                    , time >= 1.9
                    , containers >= 0.6.5
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded

test-suite medicaid-claims-dsl-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    ParserProps
    build-depends:    base >=4.14 && <5
                    , medicaid-claims-dsl
                    , hspec >= 2.9.0 && < 2.12
                    , QuickCheck >= 2.14
                    , text >= 1.2.5
                    , aeson
                    , time >= 1.9
