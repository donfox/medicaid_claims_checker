<div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
  <div class="mx-auto max-w-7xl">
    <%= if live_flash(@flash, :error) do %>
      <div class="mb-4 p-4 bg-red-100 border border-red-300 rounded-lg">
        <p class="text-sm text-red-900 font-semibold"><%= live_flash(@flash, :error) %></p>
      </div>
    <% end %>
    
    <%= if live_flash(@flash, :info) do %>
      <div class="mb-4 p-4 bg-blue-100 border border-blue-300 rounded-lg">
        <p class="text-sm text-blue-900"><%= live_flash(@flash, :info) %></p>
      </div>
    <% end %>

    <div class="mb-6 p-4 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold text-gray-900">X12 Fraud Detection Rule Editor</h1>
      <p class="mt-2 text-base text-gray-800 font-medium">Write and test fraud detection rules using predicate logic for X12 EDI claims</p>
      <div class="mt-3 p-3 bg-blue-100 border border-blue-300 rounded-md">
        <p class="text-sm text-blue-900 font-medium"><strong>Workflow:</strong> 1) Write a rule in the DSL syntax below. 2) Paste a claim (JSON) in the Claim Document panel. 3) Click "Run Rule Against Claim" to evaluate.</p>
      </div>
    </div>

    <!-- Top Row: Rule Editor (left) and Claim Document (right) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Panel 1: Rule Editor -->
      <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-xl font-semibold mb-2 text-black">1. Rule Editor</h2>
        <p class="text-sm text-gray-900 mb-4">Write or paste a fraud detection rule using DSL syntax. Syntax is checked automatically as you type.</p>

        <.form for={%{}} phx-change="validate_rule" phx-submit="evaluate_rule" id={"rule-form-#{@rule_form_version}"}>
          <div class="mb-4">
            <textarea
              name="rule[text]"
              class="w-full h-64 p-2 font-mono text-sm border-2 border-gray-400 rounded-md bg-white text-black placeholder:text-gray-600 focus:ring-2 focus:ring-blue-600 focus:border-blue-600"
              phx-debounce="500"
              placeholder="RULE rule_name
DESCRIPTION &quot;Description&quot;
WHEN 2300.CLM.02 > 50000
THEN FLAG_FRAUD &quot;High amount&quot;
END"
            ><%= @rule_text %></textarea>
          </div>

          <%= if @parse_error do %>
            <div class="mb-4 p-3 bg-red-100 border border-red-300 rounded-md">
              <p class="text-sm text-red-900 font-semibold">Syntax Error:</p>
              <pre class="text-xs text-red-800 mt-1 whitespace-pre-wrap"><%= @parse_error %></pre>
            </div>
          <% end %>

          <%= if @parsed_rule do %>
            <div class="mb-4 p-3 bg-green-100 border border-green-300 rounded-md">
              <p class="text-sm text-green-900 font-semibold">✓ Rule syntax is valid</p>
            </div>
          <% end %>

          <%= if @parse_error == nil && @parsed_rule == nil do %>
            <div class="mb-4 p-3 bg-gray-100 border border-gray-300 rounded-md">
              <p class="text-sm text-gray-800">Enter a rule to check syntax...</p>
            </div>
          <% end %>

          <div class="flex gap-2 flex-wrap">
            <.button type="submit" disabled={@parse_error != nil || @parsed_rule == nil || @claim_json_text == "" || @claim_parse_error != nil}>
              Run Rule Against Claim
            </.button>
            <button type="button" phx-click="compile_rule" disabled={@parse_error != nil || @parsed_rule == nil} class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer">
              Compile Rule (GHC)
            </button>
            <.button type="button" phx-click="clear" class="bg-gray-600 hover:bg-gray-700">
              Clear Rule
            </.button>
          </div>
        </.form>
      </div>

      <!-- Panel 2: Claim Document -->
      <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-xl font-semibold mb-2 text-black">2. Claim Document (JSON)</h2>
        <p class="text-sm text-gray-900 mb-4">Paste your claim as a JSON object.</p>

        <div class="mb-4" id="claim-textarea-container" phx-update="ignore">
          <textarea
            id="claim-textarea"
            class="w-full h-64 p-2 font-mono text-xs border-2 border-gray-400 rounded-md bg-white text-black placeholder:text-gray-600 focus:ring-2 focus:ring-blue-600 focus:border-blue-600"
            phx-hook="ClaimTextarea"
            placeholder="Paste your JSON claim here..."
          ><%= @claim_json_text %></textarea>
        </div>

        <%= if @claim_json_text == "" do %>
          <div class="mb-4 p-3 bg-gray-100 border border-gray-300 rounded-md">
            <p class="text-sm text-gray-800">Paste a JSON claim above</p>
          </div>
        <% else %>
          <%= if @claim_parse_error do %>
            <div class="mb-4 p-3 bg-red-100 border border-red-300 rounded-md">
              <p class="text-sm text-red-900 font-semibold">JSON Error: <%= @claim_parse_error %></p>
            </div>
          <% else %>
            <div class="mb-4 p-3 bg-green-100 border border-green-300 rounded-md">
              <p class="text-sm text-green-900 font-semibold">✓ Valid JSON</p>
            </div>
          <% end %>
        <% end %>

        <div class="flex gap-2">
          <button type="button" onclick="(function(){var el=document.getElementById('claim-textarea'); el.value=''; el.textContent=''; el.innerText=''; el.innerHTML=''; console.log('Cleared textarea');})()" phx-click="clear_claim" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md text-sm font-medium cursor-pointer">
            Clear Claim
          </button>
        </div>
      </div>
    </div>

    <!-- Compilation Results (full width, shown when compiled) -->
    <%= if @compilation_result do %>
      <div class="mt-6 bg-white shadow-md rounded-lg p-6 border-l-4 border-indigo-500">
        <h3 class="text-lg font-semibold text-indigo-900 mb-3">GHC Compilation Result</h3>
        <div class="flex items-center gap-3 mb-3">
          <%= if @compilation_result["success"] do %>
            <span class="px-3 py-1 text-sm bg-green-200 text-green-900 rounded-full font-semibold">COMPILED</span>
            <span class="text-sm text-gray-700">in <%= Float.round(@compilation_result["compilationTimeMs"] / 1, 0) %>ms</span>
            <span class="text-sm text-gray-600">Rule: <strong class="text-black"><%= @compilation_result["ruleName"] %></strong></span>
          <% else %>
            <span class="px-3 py-1 text-sm bg-red-200 text-red-900 rounded-full font-semibold">COMPILATION FAILED</span>
            <p class="text-sm text-red-800"><%= @compilation_result["error"] %></p>
          <% end %>
        </div>
        <%= if @compilation_result["generatedSource"] do %>
          <details class="mt-2">
            <summary class="text-sm text-indigo-800 cursor-pointer font-medium hover:text-indigo-600">View Generated Haskell Source</summary>
            <pre class="mt-2 text-xs bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto max-h-96 overflow-y-auto"><code><%= @compilation_result["generatedSource"] %></code></pre>
          </details>
        <% end %>
      </div>
    <% end %>

    <!-- Panel 3: Evaluation Results (full width) -->
    <div class="mt-6 bg-white shadow-md rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-2 text-black">3. Evaluation Results</h2>
      <p class="text-sm text-gray-900 mb-4">Shows whether the rule matched the claim and what actions would be triggered.</p>

      <%= if @evaluation_result do %>
        <div class="space-y-4">
          <div class="p-4 bg-blue-100 border border-blue-300 rounded-md">
            <h3 class="font-semibold text-blue-900">Summary</h3>
            <p class="text-sm text-blue-900 mt-1">
              <%= get_in(@evaluation_result, ["report", "summary"]) %>
            </p>
          </div>

          <div class="p-4 border border-gray-300 rounded-md">
            <h3 class="font-semibold mb-2 text-black">Overall Risk</h3>
            <.risk_badge level={get_in(@evaluation_result, ["report", "overallRisk"])} />
            <%= if Enum.all?(get_in(@evaluation_result, ["report", "results"]) || [], fn r -> !r["resultMatched"] end) do %>
              <p class="text-sm text-gray-700 mt-2">No fraud indicators detected — rule conditions were not met for this claim.</p>
            <% end %>
          </div>

          <div>
            <h3 class="font-semibold mb-2 text-black">Rule Results</h3>
            <%= for result <- get_in(@evaluation_result, ["report", "results"]) || [] do %>
              <div class="mb-2 p-3 border border-gray-300 rounded-md">
                <div class="flex items-center justify-between">
                  <span class="font-medium text-black"><%= result["resultRuleName"] %></span>
                  <%= if result["resultMatched"] do %>
                    <span class="px-2 py-1 text-xs bg-yellow-200 text-yellow-900 rounded font-semibold">MATCHED</span>
                  <% else %>
                    <span class="px-2 py-1 text-xs bg-gray-200 text-gray-800 rounded">NOT APPLICABLE</span>
                  <% end %>
                </div>
                <p class="text-sm text-gray-900 mt-1"><%= result["resultDetails"] %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="text-center py-12 text-gray-800">
          <p class="font-medium">No evaluation results yet.</p>
          <p class="text-sm mt-2">Write a valid rule, load a claim, then click "Run Rule Against Claim".</p>
        </div>
      <% end %>
    </div>

    <!-- Panel 4: DSL Syntax Reference -->
    <div class="mt-8 bg-gray-100 shadow-md rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4 text-black">DSL Syntax Reference</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-semibold text-sm text-black mb-2">Basic Structure</h3>
          <pre class="text-xs bg-white p-3 rounded border border-gray-400 overflow-x-auto text-black"><code>RULE rule_name
DESCRIPTION "Description"
WHEN &lt;predicate&gt;
THEN &lt;action&gt;
END</code></pre>
          <p class="text-xs text-gray-800 mt-1">Or compact: <code class="text-black">RULE name "desc" WHEN ... THEN ...;</code></p>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-black mb-2">Predicates</h3>
          <ul class="text-xs space-y-1 bg-white p-3 rounded border border-gray-400 text-black">
            <li><code>field = value</code> - Equality</li>
            <li><code>field &gt; value</code> - Greater than</li>
            <li><code>field IS NULL</code> - Null check</li>
            <li><code>pred1 AND pred2</code> - Conjunction</li>
            <li><code>EXISTS loop WHERE pred</code> - Existential</li>
            <li><code>COUNT(loop) &gt; n</code> - Count check</li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-black mb-2">Field References</h3>
          <ul class="text-xs space-y-1 bg-white p-3 rounded border border-gray-400 text-black">
            <li><code>CLM.01</code> - Segment.element position</li>
            <li><code>2300.CLM.02</code> - Loop.segment.element</li>
            <li><code>NM1.03</code> - Name (element 3)</li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-black mb-2">Actions</h3>
          <ul class="text-xs space-y-1 bg-white p-3 rounded border border-gray-400 text-black">
            <li><code>FLAG_FRAUD "reason"</code></li>
            <li><code>REJECT "reason"</code></li>
            <li><code>REQUIRE_REVIEW "note"</code></li>
            <li><code>RISK_SCORE n</code> (0-100)</li>
            <li><code>[action1, action2]</code> - Multiple</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
