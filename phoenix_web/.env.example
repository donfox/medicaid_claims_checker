# Required environment variables for MedicaidClaimsChecker
# Copy this file to .env, fill in the values, and source it before starting both
# the Phoenix server and the Haskell engine.
# Never commit the filled-in .env to git (it is already in .gitignore).
#
# Generate secrets with: openssl rand -hex 32

# Shared secret between Phoenix and the Haskell rule engine.
# MUST be identical in both processes. Set before starting either server.
# Generate with: openssl rand -hex 32
RULE_ENGINE_SECRET=

# Optional: override the Haskell engine URL (default: http://localhost:8080)
RULE_ENGINE_URL=http://localhost:8080

# Brevo SMTP — used for transactional email (account setup, password reset, etc.)
BREVO_MAIL_USERNAME=
BREVO_MAIL_PASSWORD=
BREVO_MAIL_DEFAULT_SENDER=

# Optional: SFTP source for X12 claim files
SFTP_HOST=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PORT=22
