# Required environment variables for MedicaidClaimsChecker
# Copy this file, fill in the values, and source it before starting the server.
# Never commit the filled-in version to git.

# Brevo SMTP — used for transactional email (account setup, password reset, etc.)
BREVO_MAIL_USERNAME=
BREVO_MAIL_PASSWORD=
BREVO_MAIL_DEFAULT_SENDER=

# Optional: SFTP source for X12 claim files
SFTP_HOST=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PORT=22
